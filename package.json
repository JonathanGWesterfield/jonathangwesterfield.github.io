{
  "name": "jonathangwesterfield.github.io",
  "version": "0.1.0",
  "private": true,
  "description": "Jonathan Westerfield's static professional portfolio.",
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/assert-user-site-paths.mjs && node scripts/assert-site-structure.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:site": "node scripts/assert-site-structure.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "release:status": "node scripts/release-status.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^7.0.2"
  }
}
