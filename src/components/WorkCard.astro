---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { title, summary, impact, role, timeframe, technologies } = entry.data;
const href = `/work/${entry.id}/`;
const cardTechnologies = technologies.slice(0, 4);
---

<article class="work-card">
  <p class="work-card-meta">
    {role} <span aria-hidden="true">·</span> {timeframe}
  </p>
  <h3>
    <a href={href}>{title}</a>
  </h3>
  <p>{summary}</p>
  <p class="work-card-impact">
    <strong>Impact:</strong> {impact}
  </p>
  <ul class="tag-list" aria-label={`${title} technologies`}>
    {cardTechnologies.map((technology) => (
      <li>{technology}</li>
    ))}
  </ul>
  <a class="text-link" href={href}>
    Read the engineering story<span aria-hidden="true"> →</span>
  </a>
</article>
