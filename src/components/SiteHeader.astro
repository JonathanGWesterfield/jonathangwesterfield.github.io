---
import release from "../data/release.json";
import { getSiteProfile } from "../lib/site";

const profile = await getSiteProfile();
const showPortfolioContent =
  import.meta.env.DEV ||
  (release.status === "public" && profile.data.approvalStatus === "approved");
const resumeHref =
  showPortfolioContent && profile.data.resumeFile
    ? profile.data.resumeFile
    : "/resume/";

const links = [
  { href: "/#work", label: "Work" },
  { href: "/#experience", label: "Experience" },
  { href: resumeHref, label: "Résumé" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="site-name" href="/" aria-label={`${profile.data.name} home`}>
      {profile.data.name}
    </a>
    <nav aria-label="Primary navigation">
      <ul class="site-nav">
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
