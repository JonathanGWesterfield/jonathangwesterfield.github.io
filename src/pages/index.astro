---
import { getEntry } from "astro:content";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const profile = await getEntry("site", "profile");

if (!profile) {
  throw new Error("The required site profile entry is missing.");
}
---

<BaseLayout
  title={`${profile.data.name} — portfolio foundation`}
  description={profile.data.description}
>
  <SiteHeader slot="header" currentPath="/" />
  <section class="hero">
    <div class="container hero-content">
      <p class="eyebrow">Astro portfolio foundation</p>
      <h1>{profile.data.professionalTitle}</h1>
      <p class="lede">
        The new site structure, accessibility baseline, and publishing safeguards are in
        place. Public biography, work samples, and contact details will be added only
        after factual and confidentiality review.
      </p>
      <div class="action-row" aria-label="Planned portfolio sections">
        <a class="button button-primary" href="/work/">
          View work structure
        </a>
        <a class="button button-secondary" href="/resume/">
          View résumé structure
        </a>
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="foundation-heading">
    <div class="container narrow">
      <p class="eyebrow">Foundation status</p>
      <h2 id="foundation-heading">Built for a clear hiring-manager journey.</h2>
      <div class="foundation-grid">
        <article class="panel">
          <h3>Evidence-first content</h3>
          <p>
            Case studies use validated fields for responsibility, constraints, technical
            approach, approval, and confidentiality review.
          </p>
        </article>
        <article class="panel">
          <h3>Accessible by default</h3>
          <p>
            The base layout includes semantic landmarks, a skip link, visible focus,
            responsive type, and motion-safe interaction patterns.
          </p>
        </article>
        <article class="panel">
          <h3>Safe to release</h3>
          <p>
            The deployment workflow will remain gated until current public content,
            approved links, a résumé, and proof of work are ready.
          </p>
        </article>
      </div>
    </div>
  </section>
  <SiteFooter slot="footer" />
</BaseLayout>
