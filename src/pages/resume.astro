---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Résumé — portfolio foundation"
  description="Résumé structure for Jonathan Westerfield's professional portfolio."
>
  <SiteHeader slot="header" currentPath="/resume/" />
  <section class="page-intro">
    <div class="container narrow">
      <p class="eyebrow">Résumé</p>
      <h1>The approved public résumé will be added in the content phase.</h1>
      <p class="lede">
        This route will include an accessible HTML summary alongside a reviewed,
        downloadable PDF. No tailored application materials will be published here.
      </p>
    </div>
  </section>
  <SiteFooter slot="footer" />
</BaseLayout>
