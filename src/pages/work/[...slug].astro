---
import { getCollection, render, type CollectionEntry } from "astro:content";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { isPublicWork } from "../../lib/work";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const work = (await getCollection("work")).filter(isPublicWork);

  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  summary,
  role,
  timeframe,
  situation,
  responsibility,
  constraints,
  approach,
  outcome,
  relevance,
  technologies,
  links,
  heroImage,
} = entry.data;
---

<BaseLayout title={title} description={summary}>
  <SiteHeader slot="header" currentPath="/work/" />
  <article>
    <section class="page-intro">
      <div class="container narrow">
        <p class="eyebrow">Case study</p>
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
        {heroImage && (
          <figure class="case-hero-image">
            <ResponsiveImage {...heroImage} sizes="(min-width: 46rem) 46rem, 100vw" />
            <figcaption>{heroImage.alt}</figcaption>
          </figure>
        )}
        <dl class="case-meta">
          <div>
            <dt>Role</dt>
            <dd>{role}</dd>
          </div>
          <div>
            <dt>Timeframe</dt>
            <dd>{timeframe}</dd>
          </div>
        </dl>
      </div>
    </section>
    <div class="container narrow prose section">
      <section aria-labelledby="context-heading">
        <h2 id="context-heading">Context and problem</h2>
        <p>{situation}</p>
      </section>
      <section aria-labelledby="responsibility-heading">
        <h2 id="responsibility-heading">Responsibility and constraints</h2>
        <p>{responsibility}</p>
        <ul>
          {constraints.map((constraint) => (
            <li>{constraint}</li>
          ))}
        </ul>
      </section>
      <section aria-labelledby="approach-heading">
        <h2 id="approach-heading">Approach and technical decisions</h2>
        <p>{approach}</p>
        <ul class="tag-list" aria-label="Technologies used">
          {technologies.map((technology) => (
            <li>{technology}</li>
          ))}
        </ul>
      </section>
      <section aria-labelledby="outcome-heading">
        <h2 id="outcome-heading">What changed</h2>
        <p>{outcome}</p>
      </section>
      <section aria-labelledby="relevance-heading">
        <h2 id="relevance-heading">What this demonstrates</h2>
        <p>{relevance}</p>
      </section>
      {links.length > 0 && (
        <section aria-labelledby="links-heading">
          <h2 id="links-heading">Further reading</h2>
          <ul>
            {links.map((link) => (
              <li>
                <a href={link.url}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <Content />
    </div>
  </article>
  <SiteFooter slot="footer" />
</BaseLayout>
